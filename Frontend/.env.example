# Copy to Frontend/.env.local and adjust if needed.

# Where the Django API lives, including its /api prefix.
#
# Leave this unset for local development: apiService falls back to the relative
# path /api, and the Vite dev server proxies it to http://localhost:8000 (see
# vite.config.js). Set it only when the frontend is deployed somewhere the
# backend is not, e.g.
#
#   VITE_API_BASE_URL=https://your-backend.example.com/api
#
# VITE_API_BASE_URL=
