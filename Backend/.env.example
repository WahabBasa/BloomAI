# Copy to Backend/.env and fill in real values. Never commit the filled-in file.

# Required: OpenAI API key used by the three agents (question, answer, grading).
# Only needed to actually process a document — manage.py commands work without it.
OPENAI_API_KEY=sk-your-key-here

# Django secret key. Any long random string works for local development.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# Set to True for local development: enables Django debug pages and adds
# localhost to ALLOWED_HOSTS / CORS_ALLOWED_ORIGINS. Defaults to False.
DJANGO_DEBUG=True

# Optional: only needed if deploying to Azure with Postgres and Blob Storage.
# The committed settings.py uses SQLite and local disk, so these can stay unset.
AZURE_POSTGRESQL_NAME=
AZURE_POSTGRESQL_USER=
AZURE_POSTGRESQL_PASSWORD=
AZURE_POSTGRESQL_HOST=
AZURE_POSTGRESQL_PORT=
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER=
